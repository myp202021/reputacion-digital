        """
        print(f"\nIniciando análisis completo para: {self.nombre_empresa}")
        print("-"*50)
        
        # 1. Buscar información en GMB
        self.buscar_gmb()
        
        # 2. Buscar menciones en foros
        self.buscar_reclamos()
        
        # 3. Buscar noticias en medios
        self.buscar_noticias()
        
        # 4. Analizar tendencia
        self.analizar_tendencia()
        
        # 5. Calcular índice final
