    def analizar_sentimiento(self, texto, contexto=None):
        """
        Analiza el sentimiento de un texto utilizando el modelo de NLP cargado.
        Si no hay modelo disponible, utiliza una aproximación basada en palabras clave.
        
        Args:
            texto (str): Texto a analizar
            contexto (str, opcional): Contexto adicional para el análisis
            
        Returns:
            dict: Resultado del análisis con sentimiento y puntaje
        """
        if not texto:
            return {"sentimiento": "neutro", "puntaje": 0.0}
        
        # Si tenemos acceso al modelo transformer, usarlo
        if self.sentiment_analyzer:
            try:
                result = self.sentiment_analyzer(texto)
                label = result[0]["label"]
                score = result[0]["score"]
                
                if label == "POS":
                    return {"sentimiento": "positivo", "puntaje": score}
                elif label == "NEG":
                    return {"sentimiento": "negativo", "puntaje": -score}
                else:
                    return {"sentimiento": "neutro", "puntaje": 0.0}
            except:
                # Si falla el transformer, usar el método de fallback
                pass
        
        # Método de fallback: análisis simple basado en palabras clave
        palabras_positivas = ["excelente", "bueno", "recomendable", "satisfecho", "feliz", "perfecto", 
                             "genial", "increíble", "profesional", "calidad", "mejor", "positivo",
                             "eficiente", "rápido", "solución", "amable", "atento"]
        
        palabras_negativas = ["malo", "pésimo", "terrible", "horrible", "decepcionante", "problema",
                             "queja", "reclamo", "defectuoso", "lento", "costoso", "caro", "fraude",
                             "estafa", "incumplimiento", "demanda", "multa", "falla", "error"]
        
        texto_lower = texto.lower()
        
        # Contar palabras positivas y negativas
        count_pos = sum(1 for palabra in palabras_positivas if palabra in texto_lower)
        count_neg = sum(1 for palabra in palabras_negativas if palabra in texto_lower)
        
        # Calcular sentimiento
        if count_pos > count_neg:
            puntaje = min(1.0, count_pos / len(texto.split()) * 5)  # Normalize
            return {"sentimiento": "positivo", "puntaje": puntaje}
        elif count_neg > count_pos:
            puntaje = min(1.0, count_neg / len(texto.split()) * 5)  # Normalize
            return {"sentimiento": "negativo", "puntaje": -puntaje}
        else:
            return {"sentimiento": "neutro", "puntaje": 0.0}
    
    def analizar_tendencia(self):
        """
        Analiza la tendencia reciente (últimos 6 meses) en la reputación
        basada en la evolución de comentarios y noticias.
        
        Returns:
            dict: Información sobre tendencias que incluye dirección y velocidad
        """
        print("Analizando tendencias de los últimos 6 meses...")
        
        # Crear línea de tiempo de los últimos 6 meses
        hoy = datetime.datetime.now()
        meses = []
        for i in range(6):
            mes_actual = hoy - datetime.timedelta(days=30 * i)
            meses.append(mes_actual.strftime("%m/%Y"))
        
        meses.reverse()  # Ordenar cronológicamente
        
        # Inicializar datos de tendencia
        tendencia = {
            "meses": meses,
            "valores_promedio": [],
            "comentarios_por_mes": [],
            "noticias_por_mes": [],
            "direccion": "estable",
            "velocidad": 0.0
        }
        
        # Combinar datos de comentarios y noticias por mes
        for mes in meses:
            valor_promedio = 50.0  # Valor base
            contador_comentarios = 0
            contador_noticias = 0
            
            # Contar comentarios de GMB
            comentarios_mes = [c for c in self.datos["gmb"].get("comentarios", []) 
                             if datetime.datetime.strptime(c["fecha"], "%d/%m/%Y").strftime("%m/%Y") == mes]
            
            for c in comentarios_mes:
                if c["sentimiento"] == "positivo":
                    valor_promedio += 5
                elif c["sentimiento"] == "negativo":
                    valor_promedio -= 5
                contador_comentarios += 1
            
            # Contar comentarios de foros
            comentarios_foros_mes = [c for c in self.datos["foros"].get("comentarios", []) 
                                   if datetime.datetime.strptime(c["fecha"], "%d/%m/%Y").strftime("%m/%Y") == mes]
            
            for c in comentarios_foros_mes:
                if c["sentimiento"] == "positivo":
                    valor_promedio += 3
                elif c["sentimiento"] == "negativo":
                    valor_promedio -= 4  # Los comentarios negativos en foros tienen más impacto
                contador_comentarios += 1
            
            # Contar noticias
            noticias_mes = [n for n in self.datos["noticias"].get("noticias", []) 
                          if datetime.datetime.strptime(n["fecha"], "%d/%m/%Y").strftime("%m/%Y") == mes]
            
            for n in noticias_mes:
                if n["sentimiento"] == "positivo":
                    valor_promedio += 8  # Las noticias positivas tienen más impacto
                elif n["sentimiento"] == "negativo":
                    valor_promedio -= 10  # Las noticias negativas tienen mucho impacto
                contador_noticias += 1
            
            # Normalizar el valor promedio entre 0 y 100
            valor_promedio = max(0, min(100, valor_promedio))
            
            tendencia["valores_promedio"].append(valor_promedio)
            tendencia["comentarios_por_mes"].append(contador_comentarios)
            tendencia["noticias_por_mes"].append(contador_noticias)
        
        # Calcular dirección de la tendencia
        if len(tendencia["valores_promedio"]) >= 2:
            ultimo_valor = tendencia["valores_promedio"][-1]
            primer_valor = tendencia["valores_promedio"][0]
            
            cambio = ultimo_valor - primer_valor
            velocidad = cambio / (len(tendencia["valores_promedio"]) - 1)
            
            if cambio > 5:
                tendencia["direccion"] = "positiva"
            elif cambio < -5:
                tendencia["direccion"] = "negativa"
            else:
                tendencia["direccion"] = "estable"
                
            tendencia["velocidad"] = velocidad
            
            # Verificar si hay caída sostenida (alerta)
            if all(tendencia["valores_promedio"][i] > tendencia["valores_promedio"][i+1] 
                  for i in range(len(tendencia["valores_promedio"])-1)):
                self.alertas.append({
                    "tipo": "caida_sostenida",
                    "descripcion": "Se detectó una caída sostenida en la reputación durante los últimos 6 meses",
                    "nivel": "medio"
                })
        
        # Guardar resultados en el diccionario de datos
        self.datos["tendencia"] = tendencia
        
        print(f"✓ Análisis de tendencias completado: tendencia {tendencia['direccion']}")
        return self.datos["tendencia"]
    
    def calcular_indice(self):
        """
        Calcula el índice final de reputación digital (0-100) basado en las ponderaciones
        definidas y todos los datos recopilados.
        
        Returns:
            float: Índice final de reputación digital
        """
        print("Calculando índice de reputación digital...")
        
        # Inicializar subíndices
        self.subindices = {
            "rating_gmb": 0,
            "volumen_comentarios": 0,
            "sentimiento_foros": 0,
            "sentimiento_noticias": 0,
            "tendencia_reciente": 0
        }
        
        # 1. Calcular subíndice de rating GMB (0-100)
        if "rating_promedio" in self.datos["gmb"]:
            # Convertir rating de 1-5 a escala 0-100
            rating_normalizado = (self.datos["gmb"]["rating_promedio"] - 1) / 4 * 100
            self.subindices["rating_gmb"] = rating_normalizado
        
        # 2. Calcular subíndice de volumen de comentarios (0-100)
        total_comentarios = 0
        if "num_reviews" in self.datos["gmb"]:
            total_comentarios += self.datos["gmb"]["num_reviews"]
        
        if "total_menciones" in self.datos["foros"]:
            total_comentarios += self.datos["foros"]["total_menciones"]
        
        # Normalizar el volumen de comentarios (más es mejor, hasta cierto punto)
        volumen_normalizado = min(100, total_comentarios / 5)  # 500 comentarios = 100%
        self.subindices["volumen_comentarios"] = volumen_normalizado
        
        # 3. Calcular subíndice de sentimiento en foros (0-100)
        if "menciones_positivas" in self.datos["foros"] and self.datos["foros"]["total_menciones"] > 0:
            # Calcular porcentaje de menciones positivas vs negativas
            menciones_positivas = self.datos["foros"]["menciones_positivas"]
            menciones_negativas = self.datos["foros"]["menciones_negativas"]
            menciones_neutras = self.datos["foros"]["menciones_neutras"]
            
            total_ponderado = menciones_positivas + menciones_neutras * 0.5 + menciones_negativas * 0
            total_posible = self.datos["foros"]["total_menciones"]
            
            sentimiento_foros_normalizado = (total_ponderado / total_posible) * 100
            self.subindices["sentimiento_foros"] = sentimiento_foros_normalizado
        
        # 4. Calcular subíndice de sentimiento en noticias (0-100)
        if "noticias_positivas" in self.datos["noticias"] and self.datos["noticias"]["total_noticias"] > 0:
            # Calcular porcentaje de noticias positivas vs negativas (las noticias negativas pesan más)
            noticias_positivas = self.datos["noticias"]["noticias_positivas"]
            noticias_negativas = self.datos["noticias"]["noticias_negativas"]
            noticias_neutras = self.datos["noticias"]["noticias_neutras"]
            
            # Una noticia negativa equivale a 1.5 positivas en impacto
            total_ponderado = noticias_positivas + noticias_neutras * 0.5 - noticias_negativas * 1.5
            maximo_posible = self.datos["noticias"]["total_noticias"] * 1.0
            minimo_posible = -self.datos["noticias"]["total_noticias"] * 1.5
            rango = maximo_posible - minimo_posible
            
            # Normalizar a escala 0-100
            sentimiento_noticias_normalizado = ((total_ponderado - minimo_posible) / rango) * 100
            self.subindices["sentimiento_noticias"] = max(0, min(100, sentimiento_noticias_normalizado))
        
        # 5. Calcular subíndice de tendencia reciente (0-100)
        if "direccion" in self.datos["tendencia"]:
            # Valorar dirección y velocidad de la tendencia
            if self.datos["tendencia"]["direccion"] == "positiva":
                # Entre 50 y 100 dependiendo de la velocidad
                tendencia_normalizada = 50 + min(50, self.datos["tendencia"]["velocidad"] * 10)
            elif self.datos["tendencia"]["direccion"] == "negativa":
                # Entre 0 y 50 dependiendo de la velocidad
                tendencia_normalizada = 50 + max(-50, self.datos["tendencia"]["velocidad"] * 10)
            else:
                tendencia_normalizada = 50  # Tendencia estable
                
            self.subindices["tendencia_reciente"] = tendencia_normalizada
        
        # Calcular índice final ponderado
        self.indice_final = 0
        for subindice, valor in self.subindices.items():
            ponderacion = CONFIG["ponderaciones"][subindice]
            self.indice_final += valor * ponderacion
        
        # Redondear a 2 decimales
        self.indice_final = round(self.indice_final, 2)
        
        print(f"✓ Índice de reputación calculado: {self.indice_final}")
        return self.indice_final
    
