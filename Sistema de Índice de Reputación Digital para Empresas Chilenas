            "gmb": {},
            "foros": {},
            "noticias": {},
            "tendencia": {}
        }
        
        # Inicializar modelo de análisis de sentimiento
        try:
            self.sentiment_analyzer = pipeline(
                "sentiment-analysis", 
                model="finiteautomata/beto-sentiment-analysis"
            )
