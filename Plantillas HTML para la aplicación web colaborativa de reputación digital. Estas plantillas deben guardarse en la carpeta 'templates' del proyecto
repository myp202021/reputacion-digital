# agregar_empresa.html - Página para agregar empresas
"""
{% extends "base.html" %}

{% block title %}Agregar Empresa - ReputaciónCL{% endblock %}

{% block content %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h3 class="mb-0">Agregar Nueva Empresa</h3>
                </div>
                <div class="card-body">
                    <p class="mb-4">Complete la información para agregar una nueva empresa al sistema. Los campos marcados con * son obligatorios.</p>
                    
                    <form method="post" action="{{ url_for('agregar_empresa') }}">
                        <div class="mb-3">
                            <label for="nombre" class="form-label">Nombre de la Empresa *</label>
                            <input type="text" class="form-control" id="nombre" name="nombre" required>
                            <div class="form-text">Ingrese el nombre comercial exacto de la empresa</div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="rubro" class="form-label">Rubro *</label>
                            <select class="form-select" id="rubro" name="rubro" required>
                                <option value="">Seleccione un rubro</option>
                                {% for rubro_item in rubros %}
                                <option value="{{ rubro_item }}">{{ rubro_item }}</option>
                                {% endfor %}
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                        
                        <div class="mb-3" id="otro-rubro-container" style="display: none;">
                            <label for="otro_rubro" class="form-label">Especifique Rubro</label>
                            <input type="text" class="form-control" id="otro_rubro" name="otro_rubro">
                        </div>
                        
                        <div class="mb-3">
                            <label for="region" class="form-label">Región/Ciudad</label>
                            <input type="text" class="form-control" id="region" name="region">
                            <div class="form-text">Si la empresa opera en múltiples ciudades, ingrese la principal o deje en blanco</div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="descripcion" class="form-label">Descripción</label>
                            <textarea class="form-control" id="descripcion" name="descripcion" rows="3" 
                                      placeholder="Breve descripción de la empresa, sus productos o servicios..."></textarea>
                        </div>
                        
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="confirmar_datos" name="confirmar_datos" required>
                            <label class="form-check-label" for="confirmar_datos">
                                Confirmo que la información proporcionada es precisa y no está duplicada en el sistema *
                            </label>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-building-add"></i> Agregar Empresa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    // Mostrar/ocultar campo para "Otro rubro"
    document.getElementById('rubro').addEventListener('change', function() {
        const otroRubroContainer = document.getElementById('otro-rubro-container');
        
        if (this.value === 'Otro') {
            otroRubroContainer.style.display = 'block';
            document.getElementById('otro_rubro').setAttribute('required', 'required');
        } else {
            otroRubroContainer.style.display = 'none';
            document.getElementById('otro_rubro').removeAttribute('required');
        }
    });
</script>
{% endblock %}
