            "nombre": nombre,
            "rubro": rubro,
            "region": region,
            "descripcion": descripcion,
            "fecha_registro": datetime.datetime.now().isoformat(),
            "indice_reputacion": 50,  # Valor inicial neutral
            "rating_colaborativo": 0,
            "num_resenas_colaborativas": 0,
            "sentimiento_colaborativo": {
                "positivo": 0,
                "neutro": 0,
                "negativo": 0
            },
            "resenas_recientes": []
        }
        
