    def exportar_datos(self, formato: str = 'json') -> Tuple[bool, str, Optional[str]]:
        """
        Exporta todos los datos de reseñas y empresas.
        
        Args:
            formato (str): Formato de exportación ('json' o 'csv')
            
        Returns:
            tuple: (éxito, mensaje, contenido_o_ruta)
        """
        if formato not in ['json', 'csv']:
            return False, "Formato no soportado. Use 'json' o 'csv'", None
        
        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        
        if self.modo == "firebase":
            try:
                # Obtener datos de Firestore
                empresas = []
                for doc in self.db.collection('empresas').stream():
                    empresas.append(doc.to_dict())
                
                resenas = []
                for doc in self.db.collection('resenas').stream():
                    resenas.append(doc.to_dict())
                
                # Crear directorio de exportación si no existe
                if not os.path.exists('exports'):
                    os.makedirs('exports')
                
                if formato == 'json':
                    # Exportar como JSON
                    datos_exportacion = {
                        "timestamp": timestamp,
                        "empresas": empresas,
                        "resenas": resenas
                    }
                    
                    ruta_archivo = f"exports/export_{timestamp}.json"
                    with open(ruta_archivo, 'w', encoding='utf-8') as f:
                        json.dump(datos_exportacion, f, ensure_ascii=False, indent=4)
                    
                    return True, "Datos exportados con éxito", ruta_archivo
                
                else:  # CSV
                    import csv
                    
                    # Exportar empresas
                    ruta_empresas = f"exports/empresas_{timestamp}.csv"
                    with open(ruta_empresas, 'w', encoding='utf-8', newline='') as f:
                        if empresas:
                            # Obtener campos (aplanando estructura)
                            campos = list(empresas[0].keys())
                            
                            # Eliminar campos anidados complejos
                            if 'sentimiento_colaborativo' in campos:
                                campos.remove('sentimiento_colaborativo')
                            if 'resenas_recientes' in campos:
                                campos.remove('resenas_recientes')
                            
                            writer = csv.DictWriter(f, fieldnames=campos)
                            writer.writeheader()
                            
                            for empresa in empresas:
                                # Crear una versión plana del diccionario
                                empresa_plana = {k: v for k, v in empresa.items() if k in campos}
                                writer.writerow(empresa_plana)
                    
                    # Exportar reseñas
                    ruta_resenas = f"exports/resenas_{timestamp}.csv"
                    with open(ruta_resenas, 'w', encoding='utf-8', newline='') as f:
                        if resenas:
                            # Obtener campos (aplanando estructura)
                            campos = list(resenas[0].keys())
                            
                            # Eliminar campos anidados complejos
                            if 'sentimiento' in campos:
                                campos.remove('sentimiento')
                            
                            # Añadir campos planos para sentimiento
                            campos.extend(['sentimiento_tipo', 'sentimiento_valor'])
                            
                            writer = csv.DictWriter(f, fieldnames=campos)
                            writer.writeheader()
                            
                            for resena in resenas:
                                # Crear una versión plana del diccionario
                                resena_plana = {k: v for k, v in resena.items() if k in campos}
                                
                                # Añadir campos de sentimiento aplanados
                                if 'sentimiento' in resena and isinstance(resena['sentimiento'], dict):
                                    resena_plana['sentimiento_tipo'] = resena['sentimiento'].get('tipo', '')
                                    resena_plana['sentimiento_valor'] = resena['sentimiento'].get('valor', '')
                                
                                writer.writerow(resena_plana)
                    
                    return True, "Datos exportados con éxito", f"Empresas: {ruta_empresas}, Reseñas: {ruta_resenas}"
                
            except Exception as e:
                return False, f"Error al exportar datos: {str(e)}", None
        else:
            try:
                # Obtener datos locales
                with open('data/empresas.json', 'r', encoding='utf-8') as f:
                    empresas = json.load(f)
                
                with open('data/resenas.json', 'r', encoding='utf-8') as f:
                    resenas = json.load(f)
                
                # Crear directorio de exportación si no existe
                if not os.path.exists('exports'):
                    os.makedirs('exports')
                
                if formato == 'json':
