    def agregar_empresa(self, nombre: str, rubro: str, region: Optional[str] = None,
                      descripcion: Optional[str] = None) -> Tuple[bool, str, Optional[Dict]]:
        """
        Agrega una nueva empresa a la base de datos.
        
        Args:
            nombre (str): Nombre de la empresa
            rubro (str): Rubro o categoría
            region (str, opcional): Región o ciudad
            descripcion (str, opcional): Descripción de la empresa
            
        Returns:
            tuple: (éxito, mensaje, datos_empresa)
        """
        # Validar datos básicos
        if not nombre or len(nombre) < 3:
            return False, "El nombre de la empresa debe tener al menos 3 caracteres", None
        
        if not rubro:
            return False, "Debe especificar un rubro para la empresa", None
        
