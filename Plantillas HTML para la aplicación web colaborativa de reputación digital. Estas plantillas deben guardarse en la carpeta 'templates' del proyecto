"""
Plantillas HTML para la aplicación web colaborativa de reputación digital.
Estas plantillas deben guardarse en la carpeta 'templates' del proyecto.
"""

# base.html - Plantilla base que todas las demás extenderán
"""
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Índice de Reputación Digital{% endblock %}</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    {% block styles %}{% endblock %}
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="{{ url_for('index') }}">
                <i class="bi bi-graph-up"></i> ReputaciónCL
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('index') }}">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('buscar') }}">Buscar Empresas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('ranking') }}">Ranking</a>
                    </li>
                    {% if usuario %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('agregar_empresa') }}">Agregar Empresa</a>
                    </li>
                    {% endif %}
                </ul>
                <ul class="navbar-nav ms-auto">
                    {% if usuario %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> {{ usuario.nombre }}
                            {% if usuario.nivel %}
                            <span class="badge bg-warning text-dark">Nivel {{ usuario.nivel }}</span>
                            {% endif %}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ url_for('perfil_usuario') }}">Mi Perfil</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ url_for('logout') }}">Cerrar Sesión</a></li>
                        </ul>
                    </li>
                    {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('login') }}">
                            <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('registro') }}">
                            <i class="bi bi-person-plus"></i> Registrarse
                        </a>
                    </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <!-- Flash messages -->
    <div class="container mt-3">
        {% for category, message in get_flashed_messages(with_categories=true) %}
        <div class="alert alert-{{ category }} alert-dismissible fade show">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        {% endfor %}
    </div>

    <!-- Main Content -->
    <main class="py-4">
        {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto py-3 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5>ReputaciónCL</h5>
                    <p>Sistema de análisis colaborativo de reputación digital para empresas chilenas.</p>
                </div>
                <div class="col-md-4">
                    <h5>Enlaces</h5>
                    <ul class="list-unstyled">
                        <li><a href="{{ url_for('index') }}">Inicio</a></li>
                        <li><a href="{{ url_for('buscar') }}">Buscar Empresas</a></li>
                        <li><a href="{{ url_for('ranking') }}">Ranking</a></li>
                        <li><a href="{{ url_for('terminos') }}">Términos y Condiciones</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>Contacto</h5>
                    <p>
                        <i class="bi bi-envelope"></i> contacto@reputacioncl.cl<br>
                        <i class="bi bi-geo-alt"></i> Santiago, Chile
                    </p>
                </div>
            </div>
            <hr>
            <div class="text-center">
                <p>© 2025 ReputaciónCL - Todos los derechos reservados</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="{{ url_for('static', filename='js/main.js') }}"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
"""

# index.html - Página principal
"""
{% extends "base.html" %}

{% block title %}ReputaciónCL - Índice de Reputación Digital{% endblock %}

{% block content %}
<div class="container">
    <!-- Hero Section -->
    <div class="bg-primary text-white rounded-3 p-5 mb-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-4 fw-bold">Descubre la verdadera reputación</h1>
                <p class="lead">Consulta y comparte opiniones sobre empresas chilenas. Nuestro sistema combina análisis automático y comentarios colaborativos para entregar un índice de reputación confiable.</p>
                <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                    <a href="{{ url_for('buscar') }}" class="btn btn-light btn-lg px-4 me-md-2">Buscar Empresas</a>
                    {% if not usuario %}
                    <a href="{{ url_for('registro') }}" class="btn btn-outline-light btn-lg px-4">Registrarse</a>
                    {% endif %}
                </div>
            </div>
            <div class="col-md-4 d-none d-md-block text-center">
                <i class="bi bi-graph-up-arrow" style="font-size: 8rem;"></i>
            </div>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row mb-4 text-center">
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-building text-primary" style="font-size: 2rem;"></i>
                    <h5 class="card-title mt-3">{{ estadisticas.total_empresas }}</h5>
                    <p class="card-text text-muted">Empresas Analizadas</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-chat-quote text-primary" style="font-size: 2rem;"></i>
                    <h5 class="card-title mt-3">{{ estadisticas.total_resenas }}</h5>
                    <p class="card-text text-muted">Reseñas Publicadas</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-people text-primary" style="font-size: 2rem;"></i>
                    <h5 class="card-title mt-3">{{ estadisticas.usuarios_activos }}</h5>
                    <p class="card-text text-muted">Usuarios Activos</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-tags text-primary" style="font-size: 2rem;"></i>
                    <h5 class="card-title mt-3">{{ estadisticas.rubros_disponibles }}</h5>
                    <p class="card-text text-muted">Rubros Disponibles</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Búsqueda Rápida -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Buscar Empresa</h5>
            <form action="{{ url_for('buscar') }}" method="get">
                <div class="input-group">
                    <input type="text" class="form-control" name="q" placeholder="Nombre de la empresa...">
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Empresas Destacadas -->
    <h2 class="mb-4">Empresas Destacadas</h2>
    <div class="row row-cols-1 row-cols-md-4 g-4 mb-5">
        {% for empresa in empresas_destacadas %}
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0 text-truncate">{{ empresa.nombre }}</h5>
                    <p class="card-subtitle text-muted small">{{ empresa.rubro }}</p>
                </div>
                <div class="card-body text-center">
                    <div class="reputation-score mb-3" 
                         style="width: 100px; height: 100px; margin: 0 auto; position: relative;">
                        <svg viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="45" fill="none" stroke="#e6e6e6" stroke-width="10" />
                            <circle cx="50" cy="50" r="45" fill="none" stroke="{{ '#28a745' if empresa.indice_reputacion >= 75 else '#17a2b8' if empresa.indice_reputacion >= 50 else '#ffc107' if empresa.indice_reputacion >= 25 else '#dc3545' }}" 
                                    stroke-width="10" 
                                    stroke-dasharray="{{ empresa.indice_reputacion * 2.83 }} 283" 
                                    stroke-dashoffset="0" 
                                    transform="rotate(-90 50 50)" />
                            <text x="50" y="55" font-size="24" text-anchor="middle" fill="#333">{{ "%.0f"|format(empresa.indice_reputacion) }}</text>
                        </svg>
                    </div>
                    <p class="mb-0">
                        {% for i in range(1, 6) %}
                        {% if i <= empresa.rating_colaborativo|round(0, 'floor') %}
                        <i class="bi bi-star-fill text-warning"></i>
                        {% elif i - empresa.rating_colaborativo <= 0.5 and i - empresa.rating_colaborativo > 0 %}
                        <i class="bi bi-star-half text-warning"></i>
                        {% else %}
                        <i class="bi bi-star text-warning"></i>
                        {% endif %}
                        {% endfor %}
                        <small class="text-muted ms-1">({{ empresa.num_resenas_colaborativas }})</small>
                    </p>
                </div>
                <div class="card-footer bg-white">
                    <a href="{{ url_for('perfil_empresa', empresa_id=empresa.id) }}" class="btn btn-sm btn-outline-primary w-100">Ver Perfil</a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- Cómo Funciona -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h3 class="mb-0">¿Cómo funciona?</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 text-center mb-3 mb-md-0">
                    <div class="bg-light rounded-circle p-3 d-inline-block mb-3">
                        <i class="bi bi-search text-primary" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5>1. Busca empresas</h5>
                    <p class="text-muted">Encuentra empresas por nombre o rubro</p>
                </div>
                <div class="col-md-3 text-center mb-3 mb-md-0">
                    <div class="bg-light rounded-circle p-3 d-inline-block mb-3">
                        <i class="bi bi-bar-chart text-primary" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5>2. Revisa la reputación</h5>
                    <p class="text-muted">Índice de 0-100 basado en datos online y colaborativos</p>
                </div>
                <div class="col-md-3 text-center mb-3 mb-md-0">
                    <div class="bg-light rounded-circle p-3 d-inline-block mb-3">
                        <i class="bi bi-chat-left-text text-primary" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5>3. Lee opiniones</h5>
                    <p class="text-muted">Comentarios de usuarios verificados</p>
                </div>
                <div class="col-md-3 text-center">
                    <div class="bg-light rounded-circle p-3 d-inline-block mb-3">
                        <i class="bi bi-pen text-primary" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5>4. Comparte tu experiencia</h5>
                    <p class="text-muted">Deja tu propia reseña y contribuye</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
"""

# login.html - Página de inicio de sesión
"""
{% extends "base.html" %}

{% block title %}Iniciar Sesión - ReputaciónCL{% endblock %}

{% block content %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-white">
                    <h3 class="mb-0 text-center">Iniciar Sesión</h3>
                </div>
                <div class="card-body">
                    <!-- Formulario de login -->
                    <form method="post" action="{{ url_for('login') }}">
                        <div class="mb-3">
                            <label for="email" class="form-label">Correo Electrónico</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Contraseña</label>
                            <input type="password" class="form-control" id="password" name="password" required>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                            </button>
                        </div>
                    </form>
                    
                    <hr>
                    
                    <!-- Botón de Google (simulado) -->
                    <form method="post" action="{{ url_for('login_google') }}" id="google-form">
                        <input type="hidden" id="google_token" name="google_token" value="">
                        <input type="hidden" id="email" name="email" value="">
                        <input type="hidden" id="nombre" name="nombre" value="">
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-outline-danger" onclick="simulateGoogleLogin()">
                                <i class="bi bi-google"></i> Iniciar Sesión con Google
                            </button>
                        </div>
                    </form>
                    
                    <div class="mt-3 text-center">
                        <p>¿No tienes cuenta? <a href="{{ url_for('registro') }}">Regístrate</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    // Simular login con Google (en un sistema real usaríamos la API de Google)
    function simulateGoogleLogin() {
        // Simular datos obtenidos de Google
        document.getElementById('google_token').value = 'simulated_token_' + Math.random().toString(36).substring(2);
        document.getElementById('email').value = 'usuario.google' + Math.floor(Math.random() * 1000) + '@gmail.com';
        document.getElementById('nombre').value = 'Usuario Google';
        
        // Enviar formulario
        document.getElementById('google-form').submit();
    }
</script>
{% endblock %}
"""

# registro.html - Página de registro
"""
{% extends "base.html" %}

{% block title %}Registro - ReputaciónCL{% endblock %}

{% block content %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-white">
                    <h3 class="mb-0 text-center">Crear una cuenta</h3>
                </div>
                <div class="card-body">
                    <form method="post" action="{{ url_for('registro') }}">
                        <div class="mb-3">
                            <label for="nombre" class="form-label">Nombre completo</label>
                            <input type="text" class="form-control" id="nombre" name="nombre" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Contraseña</label>
                            <input type="password" class="form-control" id="password" name="password" 
                                   required minlength="8"
                                   pattern="(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d]{8,}"
                                   title="La contraseña debe tener al menos 8 caracteres, incluyendo al menos una letra y un número">
                            <div class="form-text">Mínimo 8 caracteres, debe incluir letras y números</div>
                        </div>
                        <div class="mb-3">
                            <label for="confirm_password" class="form-label">Confirmar contraseña</label>
                            <input type="password" class="form-control" id="confirm_password" name="confirm_password" required>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="acepta_terminos" name="acepta_terminos" required>
                            <label class="form-check-label" for="acepta_terminos">
                                Acepto los <a href="{{ url_for('terminos') }}" target="_blank">Términos y Condiciones</a> y el uso de mis datos para análisis
                            </label>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Registrarme</button>
                        </div>
                    </form>
                    
                    <div class="mt-3 text-center">
                        <p>¿Ya tienes cuenta? <a href="{{ url_for('login') }}">Inicia sesión</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    // Validar que las contraseñas coincidan
    document.getElementById('confirm_password').addEventListener('input', function() {
        const password = document.getElementById('password').value;
        const confirmPassword = this.value;
        
        if (password !== confirmPassword) {
            this.setCustomValidity('Las contraseñas no coinciden');
        } else {
            this.setCustomValidity('');
        }
    });
</script>
{% endblock %}
