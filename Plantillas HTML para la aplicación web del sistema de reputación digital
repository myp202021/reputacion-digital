# index.html - Página principal con formulario de análisis
"""
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Índice de Reputación Digital</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .hero-section {
            background: linear-gradient(135deg, #19a0aa, #0056b3);
            color: white;
            padding: 4rem 0;
            margin-bottom: 2rem;
        }
        
        .card {
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 2rem;
        }
        
        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            padding: 1rem;
        }
        
        .btn-primary {
            background-color: #19a0aa;
            border-color: #19a0aa;
        }
        
        .btn-primary:hover {
            background-color: #148a93;
            border-color: #148a93;
        }
        
        footer {
            background-color: #f8f9fa;
            padding: 2rem 0;
            margin-top: 3rem;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Índice de Reputación Digital</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="/">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/historial">Historial</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container text-center">
            <h1 class="display-4">Índice de Reputación Digital</h1>
            <p class="lead">Analiza la reputación online de empresas chilenas combinando múltiples fuentes de datos</p>
        </div>
    </section>

    <!-- Main Content -->
    <div class="container">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">Análisis de Reputación</h3>
                    </div>
                    <div class="card-body">
                        <form id="analisisForm" action="/analizar" method="post">
                            <div class="mb-3">
                                <label for="nombre_empresa" class="form-label">Nombre de la Empresa *</label>
                                <input type="text" class="form-control" id="nombre_empresa" name="nombre_empresa" required>
                                <div class="form-text">Ingrese el nombre comercial de la empresa (Ejemplo: "Sodimac", "Betterfly").</div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="region" class="form-label">Región o Ciudad</label>
                                <input type="text" class="form-control" id="region" name="region">
                                <div class="form-text">Opcional: especifique la región o ciudad donde opera la empresa.</div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="rubro" class="form-label">Rubro de la Empresa</label>
                                <select class="form-select" id="rubro" name="rubro">
                                    <option value="">Seleccionar rubro (opcional)</option>
                                    <option value="Retail">Retail</option>
                                    <option value="Tecnología">Tecnología</option>
                                    <option value="Salud">Salud</option>
                                    <option value="Educación">Educación</option>
                                    <option value="Finanzas">Finanzas</option>
                                    <option value="Telecomunicaciones">Telecomunicaciones</option>
                                    <option value="Transporte">Transporte</option>
                                    <option value="Construcción">Construcción</option>
                                    <option value="Energía">Energía</option>
                                    <option value="Alimentos">Alimentos</option>
                                    <option value="Entretenimiento">Entretenimiento</option>
                                    <option value="Turismo">Turismo</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary" id="btnAnalizar">
                                    <span class="spinner-border spinner-border-sm d-none" id="loadingSpinner" role="status" aria-hidden="true"></span>
                                    Analizar Reputación
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
                
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">¿Cómo funciona?</h3>
                    </div>
                    <div class="card-body">
                        <h5>Fuentes de datos analizadas:</h5>
                        <ul>
                            <li><strong>Google My Business</strong>: ratings, número de reviews y comentarios recientes.</li>
                            <li><strong>Redes sociales y foros</strong>: Reclamos.cl, Reddit, Twitter y foros públicos.</li>
                            <li><strong>Medios de prensa chilenos</strong>: BioBio, Emol, La Tercera, DF, y otros.</li>
                        </ul>
                        
                        <h5>Componentes del índice:</h5>
                        <ul>
                            <li><strong>Rating GMB</strong> (30%): Valoración promedio en Google.</li>
                            <li><strong>Volumen de comentarios</strong> (10%): Cantidad de menciones en todas las fuentes.</li>
                            <li><strong>Sentimiento en foros</strong> (20%): Análisis de las opiniones en plataformas públicas.</li>
                            <li><strong>Sentimiento en noticias</strong> (30%): Valoración de la empresa en medios de prensa.</li>
                            <li><strong>Tendencia reciente</strong> (10%): Evolución de la reputación en los últimos 6 meses.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="text-center">
        <div class="container">
            <p>Sistema de Índice de Reputación Digital para Empresas Chilenas</p>
            <p class="text-muted">© 2025</p>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Mostrar spinner al enviar formulario
        document.getElementById('analisisForm').addEventListener('submit', function() {
            document.getElementById('loadingSpinner').classList.remove('d-none');
            document.getElementById('btnAnalizar').disabled = true;
            document.getElementById('btnAnalizar').innerHTML = 'Analizando... (puede tomar unos minutos)';
        });
    </script>
</body>
</html>
