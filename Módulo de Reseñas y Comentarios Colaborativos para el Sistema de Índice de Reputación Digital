                    return True, "Datos exportados con éxito", ruta_archivo
                
                else:  # CSV
                    import csv
                    
                    # Exportar empresas
                    ruta_empresas = f"exports/empresas_{timestamp}.csv"
                    with open(ruta_empresas, 'w', encoding='utf-8', newline='') as f:
                        if empresas:
                            # Obtener campos (aplanando estructura)
                            campos = list(empresas[0].keys())
                            
                            # Eliminar campos anidados complejos
                            if 'sentimiento_colaborativo' in campos:
                                campos.remove('sentimiento_colaborativo')
                            if 'resenas_recientes' in campos:
                                campos.remove('resenas_recientes')
                            
                            writer = csv.DictWriter(f, fieldnames=campos)
                            writer.writeheader()
                            
                            for empresa in empresas:
                                # Crear una versión plana del diccionario
                                empresa_plana = {k: v for k, v in empresa.items() if k in campos}
