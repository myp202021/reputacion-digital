                # Verificar si ya existe una empresa con el mismo nombre
                if any(e['nombre'].lower() == nombre.lower() for e in empresas):
                    return False, "Ya existe una empresa con ese nombre", None
                
                # Añadir nueva empresa
                empresas.append(empresa)
                
                # Guardar empresas actualizadas
                with open('data/empresas.json', 'w', encoding='utf-8') as f:
                    json.dump(empresas, f, indent=4)
                
                return True, "Empresa agregada con éxito", empresa
                
