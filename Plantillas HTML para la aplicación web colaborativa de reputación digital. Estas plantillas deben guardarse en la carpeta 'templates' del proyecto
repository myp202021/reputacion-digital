                                    </div>
                                    <div class="report-button">
                                        <button class="btn btn-sm btn-link text-muted report-review-btn" data-bs-toggle="modal" data-bs-target="#reportModal" data-review-id="{{ resena.id }}">
                                            <i class="bi bi-flag"></i> Reportar
