                            <th scope="col" class="text-center">Rating</th>
                            <th scope="col" class="text-center">Reseñas</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for empresa in empresas %}
                        <tr>
                            <td class="text-center fw-bold">{{ loop.index }}</td>
                            <td>{{ empresa.nombre }}</td>
                            <td>{{ empresa.rubro }}</td>
                            <td class="text-center">
                                <span class="badge 
                                    {% if empresa.indice_reputacion >= 80 %}bg-success
                                    {% elif empresa.indice_reputacion >= 60 %}bg-info
                                    {% elif empresa.indice_reputacion >= 40 %}bg-warning text-dark
                                    {% else %}bg-danger{% endif %}
                                    fs-6 rounded-pill">
                                    {{ empresa.indice_reputacion|round|int }}
                                </span>
                            </td>
                            <td class="text-center">
                                {% for i in range(1, 6) %}
                                {% if i <= empresa.rating_colaborativo|round(0, 'floor') %}
