    def buscar_empresa_por_nombre(self, nombre: str, limite: int = 10) -> List[Dict]:
        """
        Busca empresas por nombre o coincidencia parcial.
        
        Args:
            nombre (str): Nombre o parte del nombre a buscar
            limite (int): Número máximo de resultados
            
        Returns:
            list: Lista de empresas coincidentes
        """
        nombre = nombre.lower()
        
        if self.modo == "firebase":
            try:
                # Firestore no soporta búsquedas parciales nativas
                # Esta es una implementación simple que obtiene todas las empresas
                # y filtra en memoria (no recomendado para grandes volúmenes de datos)
                empresas = []
                query = self.db.collection('empresas').limit(100)  # Limitar la cantidad inicial
                
                for doc in query.stream():
                    empresa = doc.to_dict()
                    if nombre in empresa.get('nombre', '').lower():
                        empresas.append(empresa)
                        if len(empresas) >= limite:
                            break
                
                return empresas
                
            except Exception as e:
                print(f"Error al buscar empresas: {e}")
                return []
        else:
            try:
                # Cargar empresas
                with open('data/empresas.json', 'r', encoding='utf-8') as f:
                    todas_empresas = json.load(f)
                
                # Filtrar por nombre (coincidencia parcial)
                empresas_coincidentes = [
                    e for e in todas_empresas 
                    if nombre in e.get('nombre', '').lower()
                ]
                
                # Limitar resultados
                return empresas_coincidentes[:limite]
                
            except Exception as e:
                print(f"Error al buscar empresas: {e}")
                return []
    
