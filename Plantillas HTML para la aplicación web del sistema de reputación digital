# resultados.html - Página de resultados del análisis
"""
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultados - {{ resultados.empresa }}</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Plotly.js -->
    <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
    <style>
        .hero-section {
            background: linear-gradient(135deg, #19a0aa, #0056b3);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
        }
        
        .card {
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 2rem;
        }
        
        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            padding: 1rem;
        }
        
        .indice-container {
            text-align: center;
            padding: 2rem;
        }
        
        .indice-valor {
            font-size: 4rem;
            font-weight: bold;
        }
        
        .indice-escala {
            font-size: 1.2rem;
            margin-top: -1rem;
        }
        
        .indice-interpretacion {
            font-size: 1.5rem;
            font-weight: 500;
            margin-top: 1rem;
        }
        
        .excelente {
            color: #28a745;
        }
        
        .bueno {
            color: #17a2b8;
        }
        
        .regular {
            color: #ffc107;
        }
        
        .deficiente {
            color: #dc3545;
        }
        
        .alerta {
            background-color: #fff3cd;
            border-left: 5px solid #ffc107;
        }
        
        .alerta-alta {
            background-color: #f8d7da;
            border-left: 5px solid #dc3545;
        }
        
        .plot-container {
            height: 500px;
        }
        
        .comentario {
            position: relative;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }
        
        .comentario-positivo {
            background-color: #d4edda;
            border-left: 5px solid #28a745;
        }
        
        .comentario-negativo {
            background-color: #f8d7da;
            border-left: 5px solid #dc3545;
        }
        
        .btn-export {
            margin-right: 0.5rem;
        }
        
        footer {
            background-color: #f8f9fa;
            padding: 2rem 0;
            margin-top: 3rem;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Índice de Reputación Digital</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/historial">Historial</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <h1>Reputación Digital: {{ resultados.empresa }}</h1>
            <p class="lead">
                {% if resultados.region %} Región: {{ resultados.region }} {% endif %}
                {% if resultados.rubro %} | Rubro: {{ resultados.rubro }} {% endif %}
                | Fecha: {{ resultados.fecha }}
            </p>
        </div>
    </section>

    <!-- Main Content -->
    <div class="container">
        <div class="row">
            <!-- Índice de Reputación -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">Índice de Reputación</h3>
                    </div>
                    <div class="card-body">
                        <div class="indice-container">
                            <div class="indice-valor">{{ resultados.indice_final }}</div>
                            <div class="indice-escala">/ 100</div>
                            
                            {% if resultados.indice_final >= 80 %}
                                <div class="indice-interpretacion excelente">EXCELENTE</div>
                            {% elif resultados.indice_final >= 60 %}
                                <div class="indice-interpretacion bueno">BUENO</div>
                            {% elif resultados.indice_final >= 40 %}
                                <div class="indice-interpretacion regular">REGULAR</div>
                            {% else %}
                                <div class="indice-interpretacion deficiente">DEFICIENTE</div>
                            {% endif %}
                            
                            <div class="mt-4">
                                <a href="/exportar/{{ resultados.id }}/json" class="btn btn-sm btn-outline-primary btn-export">
                                    <i class="bi bi-download"></i> Exportar JSON
                                </a>
                                <a href="/exportar/{{ resultados.id }}/csv" class="btn btn-sm btn-outline-secondary btn-export">
                                    <i class="bi bi-download"></i> Exportar CSV
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Alertas -->
                {% if resultados.alertas %}
                    <div class="card">
                        <div class="card-header">
                            <h3 class="mb-0">Alertas Detectadas</h3>
                        </div>
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush">
                                {% for alerta in resultados.alertas %}
                                    <li class="list-group-item {% if alerta.nivel == 'alto' %}alerta-alta{% else %}alerta{% endif %}">
                                        <strong>{{ alerta.nivel | upper }}:</strong> {{ alerta.descripcion }}
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endif %}
                
                <!-- Subíndices -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">Componentes del Índice</h3>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Componente</th>
                                    <th>Valor</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for nombre, valor in resultados.subindices.items() %}
                                    <tr>
                                        <td>
                                            {% if nombre == 'rating_gmb' %}
                                                Rating GMB
                                            {% elif nombre == 'volumen_comentarios' %}
                                                Volumen comentarios
                                            {% elif nombre == 'sentimiento_foros' %}
                                                Sentimiento foros
                                            {% elif nombre == 'sentimiento_noticias' %}
                                                Sentimiento noticias
                                            {% elif nombre == 'tendencia_reciente' %}
                                                Tendencia reciente
                                            {% else %}
                                                {{ nombre }}
                                            {% endif %}
                                        </td>
                                        <td>{{ valor }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <!-- Gráficos -->
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">Composición del Índice</h3>
                    </div>
                    <div class="card-body">
                        <div id="grafico-composicion" class="plot-container"></div>
                    </div>
                </div>
                
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">Evolución Temporal</h3>
                    </div>
                    <div class="card-body">
                        <div id="grafico-evolucion" class="plot-container"></div>
                    </div>
                </div>
                
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">Subíndices</h3>
                    </div>
                    <div class="card-body">
                        <div id="grafico-subindices" class="plot-container"></div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="row mt-4">
            <!-- Comentarios destacados -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">Comentarios Positivos</h3>
                    </div>
                    <div class="card-body">
                        {% for comentario in resultados.comentarios_destacados.positivos %}
                            <div class="comentario comentario-positivo">
                                <p class="mb-1">{{ comentario.texto }}</p>
                                <small class="text-muted">{{ comentario.fuente }} - {{ comentario.fecha }}</small>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">Comentarios Negativos</h3>
                    </div>
                    <div class="card-body">
                        {% for comentario in resultados.comentarios_destacados.negativos %}
                            <div class="comentario comentario-negativo">
                                <p class="mb-1">{{ comentario.texto }}</p>
                                <small class="text-muted">{{ comentario.fuente }} - {{ comentario.fecha }}</small>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="text-center">
        <div class="container">
            <p>Sistema de Índice de Reputación Digital para Empresas Chilenas</p>
            <p class="text-muted">© 2025</p>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Plotly Charts -->
    <script>
        // Cargar gráfico de composición
        var composicionData = {{ resultados.graficos.composicion | safe }};
        Plotly.newPlot('grafico-composicion', composicionData.data, composicionData.layout);
        
        // Cargar gráfico de evolución
        var evolucionData = {{ resultados.graficos.evolucion | safe }};
        Plotly.newPlot('grafico-evolucion', evolucionData.data, evolucionData.layout);
        
        // Cargar gráfico de subíndices
        var subindicesData = {{ resultados.graficos.subindices | safe }};
        Plotly.newPlot('grafico-subindices', subindicesData.data, subindicesData.layout);
        
        // Hacer responsive los gráficos
        window.onresize = function() {
            Plotly.relayout('grafico-composicion', {
                'xaxis.autorange': true,
                'yaxis.autorange': true
            });
            Plotly.relayout('grafico-evolucion', {
                'xaxis.autorange': true,
                'yaxis.autorange': true
            });
            Plotly.relayout('grafico-subindices', {
                'xaxis.autorange': true,
                'yaxis.autorange': true
            });
        };
    </script>
</body>
</html>
"""

