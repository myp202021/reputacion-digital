    def exportar_resultados(self, formato="json", ruta=None):
        """
        Exporta los resultados del análisis a un archivo JSON o CSV.
        
        Args:
            formato (str): Formato de exportación ('json' o 'csv')
            ruta (str, opcional): Ruta de destino del archivo
            
        Returns:
            str: Ruta del archivo exportado
        """
        print(f"Exportando resultados en formato {formato}...")
        
        if ruta is None:
            timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
            ruta = f"reputacion_{self.nombre_empresa.replace(' ', '_')}_{timestamp}.{formato}"
        
        # Preparar datos para exportación
        datos_exportacion = {
            "empresa": self.nombre_empresa,
            "region": self.region,
            "rubro": self.rubro,
            "fecha_analisis": self.fecha_analisis.strftime("%d/%m/%Y %H:%M:%S"),
            "indice_final": self.indice_final,
            "subindices": self.subindices,
            "alertas": self.alertas,
            "comentarios_destacados": self.comentarios_destacados
        }
        
        # Exportar según formato
        if formato == "json":
            with open(ruta, 'w', encoding='utf-8') as f:
                json.dump(datos_exportacion, f, ensure_ascii=False, indent=4)
        
        elif formato == "csv":
            # Para CSV se exporta una versión simplificada
            with open(ruta, 'w', encoding='utf-8') as f:
                # Cabecera
                f.write("Empresa,Región,Rubro,Fecha Análisis,Índice Final\n")
                
                # Datos generales
                f.write(f"{self.nombre_empresa},{self.region or ''},")
                f.write(f"{self.rubro or ''},")
                f.write(f"{self.fecha_analisis.strftime('%d/%m/%Y %H:%M:%S')},")
                f.write(f"{self.indice_final}\n\n")
                
                # Subíndices
                f.write("Subíndice,Valor\n")
                for subindice, valor in self.subindices.items():
                    f.write(f"{subindice},{valor}\n")
                
                # Alertas
                f.write("\nAlertas\n")
                for alerta in self.alertas:
                    f.write(f"{alerta['tipo']},{alerta['descripcion']},{alerta['nivel']}\n")
        
        print(f"✓ Resultados exportados a: {ruta}")
        return ruta
    
