def crear_app_flask():
    """
    Crea una interfaz web simple con Flask para el sistema de reputación digital.
    
    Returns:
        Flask app: Aplicación Flask configurada
    """
    from flask import Flask, request, render_template, jsonify
    
    app = Flask(__name__)
    
    @app.route('/')
    def index():
        return render_template('index.html')
    
    @app.route('/analizar', methods=['POST'])
    def analizar():
        nombre_empresa = request.form.get('nombre_empresa')
        region = request.form.get('region')
        rubro = request.form.get('rubro')
        
        if not nombre_empresa:
            return jsonify({"error": "Debe proporcionar el nombre de la empresa"}), 400
        
        # Crear instancia y ejecutar análisis
        analizador = IndiceReputacionDigital(nombre_empresa, region, rubro)
        resultado = analizador.ejecutar_analisis_completo()
        
        # Generar gráficos interactivos con Plotly
        graficos = analizador.generar_graficos_plotly()
        
        # Convertir gráficos a JSON para enviar al frontend
        graficos_json = {
            "composicion": graficos["composicion"].to_json(),
            "evolucion": graficos["evolucion"].to_json(),
            "subindices": graficos["subindices"].to_json()
        }
        
        # Combinar resultado y gráficos
        resultado_completo = {
            "datos": resultado,
            "graficos": graficos_json
        }
        
        return jsonify(resultado_completo)
    
    return app

