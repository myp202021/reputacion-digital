                                    resena_plana['sentimiento_tipo'] = resena['sentimiento'].get('tipo', '')
                                    resena_plana['sentimiento_valor'] = resena['sentimiento'].get('valor', '')
                                
                                writer.writerow(resena_plana)
                    
                    return True, "Datos exportados con éxito", f"Empresas: {ruta_empresas}, Reseñas: {ruta_resenas}"
                
            except Exception as e:
