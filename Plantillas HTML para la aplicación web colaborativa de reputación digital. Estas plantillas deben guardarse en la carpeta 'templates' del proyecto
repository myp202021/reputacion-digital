                </div>
                <div class="card-body">
                    {% if resenas %}
                        {% for resena in resenas %}
                        <div class="review-item card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div class="rating mb-1">
                                            {% for i in range(1, 6) %}
                                            {% if i <= resena.rating|round(0, 'floor') %}
                                            <i class="bi bi-star-fill text-warning"></i>
                                            {% elif i - resena.rating <= 0.5 and i - resena.rating > 0 %}
                                            <i class="bi bi-star-half text-warning"></i>
                                            {% else %}
                                            <i class="bi bi-star text-warning"></i>
                                            {% endif %}
                                            {% endfor %}
                                        </div>
                                        <div class="text-muted small">
                                            {{ resena.fecha.split('T')[0] }}
                                            {% if resena.es_cliente %}
                                            <span class="badge bg-success ms-1">Cliente verificado</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="sentiment-badge">
                                        {% if resena.sentimiento.tipo == 'positivo' %}
                                        <span class="badge bg-success"><i class="bi bi-emoji-smile"></i> Positivo</span>
                                        {% elif resena.sentimiento.tipo == 'negativo' %}
                                        <span class="badge bg-danger"><i class="bi bi-emoji-frown"></i> Negativo</span>
                                        {% else %}
                                        <span class="badge bg-secondary"><i class="bi bi-emoji-neutral"></i> Neutro</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <p class="review-text">{{ resena.texto }}</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
