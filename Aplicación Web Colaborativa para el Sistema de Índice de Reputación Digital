        ]
        
        # En una implementación real, esta lista se obtendría de la base de datos
        # con conteo de empresas por rubro
        
        return sorted(rubros_base)
    
    def _obtener_indice_reputacion(self, empresa_id: str) -> float:
        """
        Obtiene el índice de reputación automático para una empresa.
        
        Args:
            empresa_id (str): ID de la empresa
            
        Returns:
            float: Índice de reputación (0-100)
        """
        # Verificar si ya tenemos un índice calculado
        indices_path = 'data/indices_reputacion.json'
        indices = {}
        
        if os.path.exists(indices_path):
            with open(indices_path, 'r', encoding='utf-8') as f:
                indices = json.load(f)
        
        # Si la empresa tiene un índice y es reciente (menos de 7 días), usarlo
        if empresa_id in indices:
            fecha_calculo = datetime.datetime.fromisoformat(indices[empresa_id]['fecha'])
            dias_desde_calculo = (datetime.datetime.now() - fecha_calculo).days
            
            if dias_desde_calculo < 7:
                return indices[empresa_id]['indice']
        
        # Si no hay índice o es antiguo, calcularlo
        # En una implementación real, obtendríamos el nombre de la empresa
        empresa_nombre = self._obtener_nombre_empresa(empresa_id)
        
        if not empresa_nombre:
            # Si no encontramos la empresa, usar un valor predeterminado
            return 50.0
        
        # Calcular índice usando el módulo existente
        try:
            analizador = IndiceReputacionDigital(empresa_nombre)
            analizador.buscar_gmb()
            analizador.buscar_reclamos()
            analizador.buscar_noticias()
            analizador.analizar_tendencia()
            indice = analizador.calcular_indice()
            
            # Guardar para uso futuro
            indices[empresa_id] = {
                'indice': indice,
                'fecha': datetime.datetime.now().isoformat()
            }
            
            with open(indices_path, 'w', encoding='utf-8') as f:
                json.dump(indices, f, indent=4)
            
            return indice
            
        except Exception as e:
            logger.error(f"Error al calcular índice para {empresa_id}: {e}")
            return 50.0  # Valor predeterminado en caso de error
    
    def _obtener_nombre_empresa(self, empresa_id: str) -> Optional[str]:
        """
        Obtiene el nombre de una empresa por su ID.
        
        Args:
            empresa_id (str): ID de la empresa
            
        Returns:
            str: Nombre de la empresa o None si no se encuentra
        """
        empresa = self.reviews.obtener_empresa(empresa_id)
        
        if empresa:
            return empresa.get('nombre')
        
        return None
    
    def _actualizar_indice_empresa(self, empresa_id: str, indice: float) -> bool:
        """
        Actualiza el índice de reputación de una empresa.
        
        Args:
            empresa_id (str): ID de la empresa
            indice (float): Nuevo índice de reputación
            
        Returns:
            bool: True si se actualizó correctamente
        """
        try:
            # En modo Firebase, actualizar en Firestore
            if self.modo_db == "firebase" and hasattr(self.reviews, 'db'):
                self.reviews.db.collection('empresas').document(empresa_id).update({
                    'indice_reputacion': indice,
                    'ultima_actualizacion': datetime.datetime.now().isoformat()
                })
                return True
            
            # En modo local, actualizar en el archivo JSON
            else:
                empresas_path = 'data/empresas.json'
                if not os.path.exists(empresas_path):
                    return False
                
                with open(empresas_path, 'r', encoding='utf-8') as f:
                    empresas = json.load(f)
                
                for i, empresa in enumerate(empresas):
                    if empresa['id'] == empresa_id:
                        empresas[i]['indice_reputacion'] = indice
                        empresas[i]['ultima_actualizacion'] = datetime.datetime.now().isoformat()
                        
                        with open(empresas_path, 'w', encoding='utf-8') as f:
                            json.dump(empresas, f, indent=4)
                        
                        return True
                
                return False
                
        except Exception as e:
            logger.error(f"Error al actualizar índice para {empresa_id}: {e}")
            return False
    
