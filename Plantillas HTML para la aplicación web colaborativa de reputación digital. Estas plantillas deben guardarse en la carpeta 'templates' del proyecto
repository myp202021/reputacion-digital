# perfil.html - Página de perfil de usuario
"""
{% extends "base.html" %}

{% block title %}Mi Perfil - ReputaciónCL{% endblock %}

{% block content %}
<div class="container">
    <div class="row">
        <!-- Información del usuario -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h4 class="mb-0">Mi Perfil</h4>
                </div>
                <div class="card-body text-center">
                    <div class="avatar mb-3">
                        <i class="bi bi-person-circle" style="font-size: 6rem; color: #6c757d;"></i>
                    </div>
                    <h5>{{ usuario.nombre }}</h5>
                    <p class="text-muted">{{ usuario.email }}</p>
                    
                    <div class="user-level mb-3">
                        <span class="badge rounded-pill bg-primary fs-6 px-3 py-2">
                            Nivel {{ usuario.nivel }}
                        </span>
                        <div class="progress mt-2">
                            {% set nivel_actual = usuario.nivel|int %}
                            {% set puntos_actual = usuario.puntos|int %}
                            
                            {% if nivel_actual == 1 %}
                                {% set limite = 100 %}
                                {% set progreso = (puntos_actual / limite * 100)|round|int %}
                            {% elif nivel_actual == 2 %}
                                {% set limite = 300 %}
                                {% set progreso = (puntos_actual / limite * 100)|round|int %}
                            {% elif nivel_actual == 3 %}
                                {% set limite = 1000 %}
                                {% set progreso = (puntos_actual / limite * 100)|round|int %}
                            {% else %}
                                {% set progreso = 100 %}
                            {% endif %}
                            
                            <div class="progress-bar" role="progressbar" style="width: {{ progreso }}%"></div>
                        </div>
                        <div class="text-muted small mt-1">{{ puntos_actual }} puntos</div>
                    </div>
                    
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Fecha de registro
                            <span>{{ usuario.fecha_registro.split('T')[0] if usuario.fecha_registro else 'N/A' }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Reseñas publicadas
                            <span class="badge bg-primary rounded-pill">{{ usuario.comentarios|length }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Tipo de cuenta
                            <span>{{ 'Google' if usuario.via_google else 'Email' }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Estado verificación
                            <span class="badge {{ 'bg-success' if usuario.verificado_cliente else 'bg-secondary' }}">
                                {{ 'Verificado' if usuario.verificado_cliente else 'Pendiente' }}
                            </span>
                        </li>
                    </ul>
                    
                    <button class="btn btn-outline-primary" disabled>
                        <i class="bi bi-pencil"></i> Editar perfil
                    </button>
                </div>
            </div>
            
            <!-- Información sobre niveles -->
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Sistema de Niveles</h5>
                </div>
                <div class="card-body">
                    <div class="level-info mb-2">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Nivel 1</span>
                            <span>0-99 puntos</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-secondary" style="width: 100%"></div>
                        </div>
                    </div>
                    <div class="level-info mb-2">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Nivel 2</span>
                            <span>100-299 puntos</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-info" style="width: 100%"></div>
                        </div>
                    </div>
                    <div class="level-info mb-2">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Nivel 3</span>
                            <span>300-999 puntos</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-primary" style="width: 100%"></div>
                        </div>
                    </div>
                    <div class="level-info">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Nivel 4</span>
                            <span>1000+ puntos</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-success" style="width: 100%"></div>
                        </div>
                    </div>
                    
                    <div class="mt-3">
                        <h6>¿Cómo ganar puntos?</h6>
                        <ul class="small">
                            <li>Publicar una reseña: <strong>+5 puntos</strong></li>
                            <li>Recibir votos útiles: <strong>+1 punto</strong> por voto</li>
                            <li>Verificar tu cuenta: <strong>+20 puntos</strong></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Historial de reseñas -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Mis Reseñas</h4>
                    <span class="badge bg-primary">{{ resenas|length }}</span>
                </div>
                <div class="card-body">
                    {% if resenas %}
                        {% for resena in resenas %}
                        <div class="review-item card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5>{{ resena.empresa_nombre }}</h5>
                                    <div class="rating">
                                        {% for i in range(1, 6) %}
                                        {% if i <= resena.rating|round(0, 'floor') %}
                                        <i class="bi bi-star-fill text-warning"></i>
                                        {% elif i - resena.rating <= 0.5 and i - resena.rating > 0 %}
                                        <i class="bi bi-star-half text-warning"></i>
                                        {% else %}
                                        <i class="bi bi-star text-warning"></i>
                                        {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                                <p class="review-text">{{ resena.texto }}</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div class="text-muted small">
                                        {{ resena.fecha.split('T')[0] }}
                                        {% if resena.es_cliente %}
                                        <span class="badge bg-success ms-1">Cliente verificado</span>
                                        {% endif %}
                                    </div>
                                    <div class="sentiment-badge">
                                        {% if resena.sentimiento.tipo == 'positivo' %}
                                        <span class="badge bg-success"><i class="bi bi-emoji-smile"></i> Positivo</span>
                                        {% elif resena.sentimiento.tipo == 'negativo' %}
                                        <span class="badge bg-danger"><i class="bi bi-emoji-frown"></i> Negativo</span>
                                        {% else %}
                                        <span class="badge bg-secondary"><i class="bi bi-emoji-neutral"></i> Neutro</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <div>
                                        <i class="bi bi-hand-thumbs-up text-primary"></i> {{ resena.votos_utiles|default(0) }} votos útiles
                                    </div>
                                    <a href="{{ url_for('perfil_empresa', empresa_id=resena.empresa_id) }}" class="btn btn-sm btn-outline-secondary">
                                        Ver empresa
                                    </a>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    {% else %}
                        <div class="text-center py-5">
                            <i class="bi bi-chat-square-text text-muted" style="font-size: 4rem;"></i>
                            <h4 class="mt-3">Aún no has publicado reseñas</h4>
                            <p class="text-muted">Comparte tu experiencia con empresas para contribuir a la comunidad</p>
                            <a href="{{ url_for('buscar') }}" class="btn btn-primary mt-2">
                                Buscar empresas para reseñar
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Exportar datos -->
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Datos y Privacidad</h5>
                </div>
                <div class="card-body">
                    <p>Puedes exportar tus datos o solicitar la eliminación de tu cuenta.</p>
                    <div class="d-flex gap-2">
                        <a href="{{ url_for('exportar_datos', formato='json') }}" class="btn btn-outline-primary">
                            <i class="bi bi-download"></i> Exportar datos (JSON)
                        </a>
                        <a href="{{ url_for('exportar_datos', formato='csv') }}" class="btn btn-outline-primary">
                            <i class="bi bi-file-earmark-spreadsheet"></i> Exportar datos (CSV)
                        </a>
                        <button class="btn btn-outline-danger" disabled>
                            <i class="bi bi-trash"></i> Eliminar cuenta
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
