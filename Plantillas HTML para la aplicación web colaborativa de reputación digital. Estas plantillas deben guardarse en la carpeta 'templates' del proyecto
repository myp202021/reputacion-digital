                                {% endif %}
                            {% else %}
                                <p><a href="{{ url_for('login') }}">Inicia sesión</a> para dejar una reseña</p>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <!-- Estadísticas y análisis -->
        <div class="col-md-4">
            <!-- Distribución de sentimiento -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Sentimiento de las reseñas</h5>
                </div>
                <div class="card-body">
                    <div class="sentiment-distribution">
                        <div class="progress mb-3" style="height: 24px;">
                            {% set total = empresa.sentimiento.positivo + empresa.sentimiento.neutro + empresa.sentimiento.negativo %}
                            {% set p_pos = (empresa.sentimiento.positivo / total * 100) if total > 0 else 0 %}
                            {% set p_neu = (empresa.sentimiento.neutro / total * 100) if total > 0 else 0 %}
                            {% set p_neg = (empresa.sentimiento.negativo / total * 100) if total > 0 else 0 %}
                            
                            <div class="progress-bar bg-success" style="width: {{ p_pos }}%" role="progressbar">
                                {{ "%.0f"|format(p_pos) }}%
                            </div>
                            <div class="progress-bar bg-secondary" style="width: {{ p_neu }}%" role="progressbar">
                                {{ "%.0f"|format(p_neu) }}%
                            </div>
                            <div class="progress-bar bg-danger" style="width: {{ p_neg }}%" role="progressbar">
                                {{ "%.0f"|format(p_neg) }}%
                            </div>
                        </div>
                        <div class="sentiment-legend">
                            <div class="d-flex justify-content-between">
                                <div><i class="bi bi-circle-fill text-success"></i> Positivo ({{ empresa.sentimiento.positivo }})</div>
                                <div><i class="bi bi-circle-fill text-secondary"></i> Neutro ({{ empresa.sentimiento.neutro }})</div>
                                <div><i class="bi bi-circle-fill text-danger"></i> Negativo ({{ empresa.sentimiento.negativo }})</div>
                            </div>
