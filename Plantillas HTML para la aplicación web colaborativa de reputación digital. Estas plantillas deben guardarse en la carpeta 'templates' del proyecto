# empresa.html - Página de perfil de empresa
"""
{% extends "base.html" %}

{% block title %}{{ empresa.nombre }} - ReputaciónCL{% endblock %}

{% block content %}
<div class="container">
    <div class="row mb-4">
        <!-- Información de la empresa -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="mb-2">{{ empresa.nombre }}</h1>
                    <div class="d-flex mb-3">
                        <span class="badge bg-primary me-2">{{ empresa.rubro }}</span>
                        {% if empresa.region %}
                        <span class="badge bg-secondary me-2">{{ empresa.region }}</span>
                        {% endif %}
                    </div>
                    <div class="row align-items-center mb-3">
                        <div class="col-md-8">
                            {% if empresa.descripcion %}
                            <p>{{ empresa.descripcion }}</p>
                            {% else %}
                            <p class="text-muted fst-italic">No hay descripción disponible</p>
                            {% endif %}
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="rating-summary">
                                <span class="display-4 fw-bold">{{ "%.1f"|format(empresa.rating_colaborativo) }}</span>
                                <div>
                                    {% for i in range(1, 6) %}
                                    {% if i <= empresa.rating_colaborativo|round(0, 'floor') %}
                                    <i class="bi bi-star-fill text-warning"></i>
                                    {% elif i - empresa.rating_colaborativo <= 0.5 and i - empresa.rating_colaborativo > 0 %}
                                    <i class="bi bi-star-half text-warning"></i>
                                    {% else %}
                                    <i class="bi bi-star text-warning"></i>
                                    {% endif %}
                                    {% endfor %}
                                </div>
                                <div class="text-muted">{{ empresa.num_resenas }} reseñas</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Índice de reputación -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h4 class="card-title mb-0">Índice de Reputación</h4>
                </div>
                <div class="card-body text-center">
                    <div class="reputation-score mb-3" 
                         style="width: 150px; height: 150px; margin: 0 auto; position: relative;">
                        <svg viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="45" fill="none" stroke="#e6e6e6" stroke-width="10" />
                            <circle cx="50" cy="50" r="45" fill="none" stroke="{{ '#28a745' if indice_final >= 75 else '#17a2b8' if indice_final >= 50 else '#ffc107' if indice_final >= 25 else '#dc3545' }}" 
                                    stroke-width="10" 
                                    stroke-dasharray="{{ indice_final * 2.83 }} 283" 
                                    stroke-dashoffset="0" 
                                    transform="rotate(-90 50 50)" />
                            <text x="50" y="55" font-size="24" text-anchor="middle" fill="#333">{{ "%.0f"|format(indice_final) }}</text>
                        </svg>
                    </div>
                    <p class="mb-0">
                        {% if indice_final >= 80 %}
                        <span class="badge bg-success fs-6">Excelente</span>
                        {% elif indice_final >= 60 %}
                        <span class="badge bg-info fs-6">Bueno</span>
                        {% elif indice_final >= 40 %}
                        <span class="badge bg-warning text-dark fs-6">Regular</span>
                        {% else %}
                        <span class="badge bg-danger fs-6">Deficiente</span>
                        {% endif %}
                    </p>
                    
                    <div class="mt-4">
                        <h6>Composición del índice</h6>
                        <div class="progress mb-2" style="height: 20px;">
                            {% set porcentaje_auto = (indice_automatico / indice_final * 100) if indice_final > 0 else 50 %}
                            {% set porcentaje_colab = 100 - porcentaje_auto %}
                            <div class="progress-bar bg-primary" style="width: {{ porcentaje_auto }}%">
                                Automático
                            </div>
                            <div class="progress-bar bg-success" style="width: {{ porcentaje_colab }}%">
                                Colaborativo
                            </div>
                        </div>
                        <div class="text-muted small">
                            <div><i class="bi bi-circle-fill text-primary"></i> Automático: {{ "%.0f"|format(indice_automatico) }}/100</div>
                            <div><i class="bi bi-circle-fill text-success"></i> Colaborativo: {{ "%.0f"|format(indice_colaborativo) }}/100</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        <!-- Reseñas y formulario -->
        <div class="col-md-8">
            <!-- Formulario de reseña -->
            {% if usuario %}
                {% if puede_comentar %}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h4 class="mb-0">Deja tu reseña</h4>
                    </div>
                    <div class="card-body">
                        <form method="post" action="{{ url_for('crear_resena', empresa_id=empresa.id) }}">
                            <div class="mb-3">
                                <label class="form-label">¿Cómo calificarías a {{ empresa.nombre }}?</label>
                                <div class="rating-input">
                                    <div class="rating-stars mb-2">
                                        {% for i in range(1, 6) %}
                                        <i class="bi bi-star rating-star fs-3" data-rating="{{ i }}"></i>
                                        {% endfor %}
                                    </div>
                                    <input type="hidden" id="rating" name="rating" value="" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="texto" class="form-label">Tu opinión</label>
                                <textarea class="form-control" id="texto" name="texto" rows="4" required minlength="20"
                                          placeholder="Comparte tu experiencia con esta empresa (mínimo 20 palabras)..."></textarea>
