                    </div>
                </div>
            </div>
            
            <!-- Fuentes de datos -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Fuentes de datos</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-google text-primary"></i> Google My Business
                            </div>
                            <span class="badge bg-primary rounded-pill">30%</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-newspaper text-primary"></i> Medios de prensa
                            </div>
                            <span class="badge bg-primary rounded-pill">30%</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-chat-dots text-primary"></i> Redes sociales y foros
                            </div>
                            <span class="badge bg-primary rounded-pill">20%</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-people text-success"></i> Reseñas colaborativas
                            </div>
                            <span class="badge bg-success rounded-pill">20%</span>
                        </li>
                    </ul>
                    <div class="mt-3 text-center">
                        <small class="text-muted">Última actualización: {{ empresa.ultima_actualizacion }}</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de reporte -->
<div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reportar reseña</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="reportForm">
                    <input type="hidden" id="reportReviewId" name="resena_id" value="">
                    <div class="mb-3">
                        <label for="reportReason" class="form-label">Motivo del reporte</label>
                        <select class="form-select" id="reportReason" required>
                            <option value="">Seleccione un motivo</option>
                            <option value="contenido_ofensivo">Contenido ofensivo o inapropiado</option>
                            <option value="informacion_falsa">Información falsa</option>
                            <option value="spam">Spam o publicidad</option>
                            <option value="otro">Otro motivo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="reportDetails" class="form-label">Detalles</label>
                        <textarea class="form-control" id="reportDetails" name="motivo" rows="3" required minlength="10"
                                  placeholder="Explique brevemente por qué reporta esta reseña..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="submitReport">Enviar reporte</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    // Funcionalidad para seleccionar rating con estrellas
    document.addEventListener('DOMContentLoaded', function() {
        const stars = document.querySelectorAll('.rating-star');
        const ratingInput = document.getElementById('rating');
        
        stars.forEach(star => {
            star.addEventListener('click', function() {
                const rating = this.getAttribute('data-rating');
                ratingInput.value = rating;
                
                // Actualizar estrellas
                stars.forEach(s => {
                    if (s.getAttribute('data-rating') <= rating) {
                        s.classList.remove('bi-star');
                        s.classList.add('bi-star-fill', 'text-warning');
                    } else {
                        s.classList.remove('bi-star-fill', 'text-warning');
                        s.classList.add('bi-star');
                    }
                });
            });
            
            // Hover effects
            star.addEventListener('mouseenter', function() {
                const rating = this.getAttribute('data-rating');
                
                stars.forEach(s => {
                    if (s.getAttribute('data-rating') <= rating) {
                        s.classList.remove('bi-star');
                        s.classList.add('bi-star-fill', 'text-warning');
                    }
                });
            });
            
            star.addEventListener('mouseleave', function() {
                const currentRating = ratingInput.value;
                
                stars.forEach(s => {
                    if (currentRating && s.getAttribute('data-rating') <= currentRating) {
                        s.classList.remove('bi-star');
                        s.classList.add('bi-star-fill', 'text-warning');
                    } else {
                        s.classList.remove('bi-star-fill', 'text-warning');
                        s.classList.add('bi-star');
                    }
                });
            });
        });
        
        // Contador de palabras
        const textarea = document.getElementById('texto');
        const wordCounter = document.getElementById('word-counter');
        const submitButton = document.getElementById('submit-review');
        
        if (textarea && wordCounter) {
            textarea.addEventListener('input', function() {
                const text = this.value.trim();
                const wordCount = text ? text.split(/\\s+/).length : 0;
                
                wordCounter.textContent = wordCount + ' palabras (mínimo 20)';
                
                if (wordCount < 20) {
                    wordCounter.classList.add('text-danger');
                    submitButton.disabled = true;
                } else {
                    wordCounter.classList.remove('text-danger');
                    submitButton.disabled = false;
                }
            });
        }
        
        // Votar reseña útil
        const voteButtons = document.querySelectorAll('.vote-button');
        voteButtons.forEach(button => {
            button.addEventListener('click', function() {
                const reviewId = this.getAttribute('data-review-id');
                
                // Llamada AJAX para votar
                fetch('{{ url_for("votar_resena", resena_id="") }}' + reviewId, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.exito) {
                        // Incrementar contador visualmente
                        this.disabled = true;
                        this.innerHTML = '<i class="bi bi-hand-thumbs-up-fill"></i> Útil';
                        
                        // Mostrar mensaje
                        const voteCount = this.querySelector('span');
                        if (voteCount) {
                            const currentCount = parseInt(voteCount.textContent.replace(/[()]/g, ''));
                            voteCount.textContent = `(${currentCount + 1})`;
                        } else {
                            this.innerHTML += ' <span>(1)</span>';
                        }
                    } else {
                        alert(data.mensaje);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al procesar su voto. Intente nuevamente.');
                });
            });
        });
        
        // Reportar reseña
        const reportButtons = document.querySelectorAll('.report-review-btn');
        const reportForm = document.getElementById('reportForm');
        const reportReviewId = document.getElementById('reportReviewId');
        const submitReportBtn = document.getElementById('submitReport');
        
        reportButtons.forEach(button => {
            button.addEventListener('click', function() {
                const reviewId = this.getAttribute('data-review-id');
                reportReviewId.value = reviewId;
            });
        });
        
        submitReportBtn.addEventListener('click', function() {
            const reason = document.getElementById('reportReason').value;
            const details = document.getElementById('reportDetails').value;
            
            if (!reason || !details || details.length < 10) {
                alert('Por favor complete todos los campos del reporte.');
                return;
            }
            
            // Llamada AJAX para reportar
            fetch('{{ url_for("reportar_resena", resena_id="") }}' + reportReviewId.value, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({
                    'motivo': `${reason}: ${details}`
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.exito) {
                    alert('Reporte enviado con éxito. Nuestro equipo lo revisará.');
                    
                    // Cerrar modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('reportModal'));
                    modal.hide();
                    
                    // Limpiar formulario
                    reportForm.reset();
                } else {
                    alert(data.mensaje);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error al procesar su reporte. Intente nuevamente.');
            });
        });
    });
</script>
{% endblock %}
