    def votar_resena_util(self, resena_id: str, usuario_id: str) -> Tuple[bool, str]:
        """
        Registra un voto de utilidad para una reseña.
        
        Args:
            resena_id (str): ID de la reseña
            usuario_id (str): ID del usuario que vota
            
        Returns:
            tuple: (éxito, mensaje)
        """
        if self.modo == "firebase":
            try:
                # Verificar si el usuario ya votó esta reseña
                voto_ref = self.db.collection('votos_resenas').where(
                    'resena_id', '==', resena_id).where(
                    'usuario_id', '==', usuario_id).limit(1)
                
                votos = list(voto_ref.stream())
                if votos:
                    return False, "Ya has votado esta reseña anteriormente"
                
                # Registrar voto
                voto_id = str(uuid.uuid4())
                voto = {
                    'id': voto_id,
                    'resena_id': resena_id,
                    'usuario_id': usuario_id,
                    'fecha': datetime.datetime.now().isoformat()
                }
                
                self.db.collection('votos_resenas').document(voto_id).set(voto)
                
                # Actualizar contador en la reseña
                resena_ref = self.db.collection('resenas').document(resena_id)
                resena_doc = resena_ref.get()
                
                if not resena_doc.exists:
                    return False, "Reseña no encontrada"
                
                resena_data = resena_doc.to_dict()
                votos_actuales = resena_data.get('votos_utiles', 0)
                
                resena_ref.update({
                    'votos_utiles': votos_actuales + 1
                })
                
                return True, "Voto registrado con éxito"
                
            except Exception as e:
                return False, f"Error al registrar voto: {str(e)}"
        else:
            try:
                # Cargar votos si existe el archivo
                votos_path = 'data/votos_resenas.json'
                if os.path.exists(votos_path):
                    with open(votos_path, 'r', encoding='utf-8') as f:
                        votos = json.load(f)
                else:
                    votos = []
                
                # Verificar si el usuario ya votó
                if any(v['resena_id'] == resena_id and v['usuario_id'] == usuario_id for v in votos):
                    return False, "Ya has votado esta reseña anteriormente"
                
                # Registrar voto
                voto_id = str(uuid.uuid4())
                voto = {
                    'id': voto_id,
                    'resena_id': resena_id,
                    'usuario_id': usuario_id,
                    'fecha': datetime.datetime.now().isoformat()
                }
                
                votos.append(voto)
                
                # Guardar votos
                with open(votos_path, 'w', encoding='utf-8') as f:
                    json.dump(votos, f, indent=4)
                
                # Actualizar reseña
                with open('data/resenas.json', 'r', encoding='utf-8') as f:
                    resenas = json.load(f)
                
                resena_encontrada = False
                for i, resena in enumerate(resenas):
                    if resena['id'] == resena_id:
                        votos_actuales = resena.get('votos_utiles', 0)
                        resenas[i]['votos_utiles'] = votos_actuales + 1
                        resena_encontrada = True
                        break
                
                if not resena_encontrada:
                    return False, "Reseña no encontrada"
                
                # Guardar reseñas actualizadas
                with open('data/resenas.json', 'w', encoding='utf-8') as f:
                    json.dump(resenas, f, indent=4)
                
                return True, "Voto registrado con éxito"
                
            except Exception as e:
                return False, f"Error al registrar voto: {str(e)}"
    
