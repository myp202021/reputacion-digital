    def _inicializar_local(self) -> None:
        """
        Inicializa el sistema de almacenamiento local.
        Crea archivos JSON locales si no existen.
        """
        # Directorio para datos locales
        if not os.path.exists('data'):
            os.makedirs('data')
        
        # Archivo de reseñas
        if not os.path.exists('data/resenas.json'):
            with open('data/resenas.json', 'w', encoding='utf-8') as f:
                json.dump([], f)
        
        # Archivo de empresas
        if not os.path.exists('data/empresas.json'):
            with open('data/empresas.json', 'w', encoding='utf-8') as f:
                json.dump([], f)
                
        print("✓ Sistema de almacenamiento local de reseñas inicializado")
    
    def _inicializar_sentiment_analyzer(self) -> None:
        """
        Inicializa el analizador de sentimiento para reseñas.
        Usa transformer si está disponible o un método simple como fallback.
        """
        if TRANSFORMERS_AVAILABLE:
            try:
                self.sentiment_analyzer = pipeline(
                    "sentiment-analysis", 
                    model="finiteautomata/beto-sentiment-analysis"
                )
                print("✓ Analizador de sentimiento inicializado (transformers)")
                return
            except Exception as e:
                print(f"Error al inicializar transformer: {e}")
        
        # Método fallback
        self.sentiment_analyzer = None
        print("✓ Analizador de sentimiento fallback inicializado")
    
    def crear_resena(self, usuario_id: str, empresa_id: str, texto: str, 
                     rating: float, es_cliente: bool) -> Tuple[bool, str, Optional[Dict]]:
        """
        Crea una nueva reseña, la valida y almacena.
        
        Args:
            usuario_id (str): ID del usuario que deja la reseña
            empresa_id (str): ID de la empresa reseñada
            texto (str): Texto de la reseña
            rating (float): Puntuación de 1 a 5
            es_cliente (bool): Si el usuario indica que fue cliente real
            
        Returns:
            tuple: (éxito, mensaje, datos_resena)
        """
        # Validaciones
        validacion_ok, mensaje = self._validar_resena(usuario_id, empresa_id, texto, rating)
        if not validacion_ok:
            return False, mensaje, None
        
        # Análisis de sentimiento
        sentimiento = self._analizar_sentimiento(texto)
        
        # Generar ID único
        resena_id = str(uuid.uuid4())
        
        # Crear objeto de reseña
        resena = {
            "id": resena_id,
            "usuario_id": usuario_id,
            "empresa_id": empresa_id,
            "texto": texto,
            "rating": rating,
            "es_cliente": es_cliente,
            "fecha": datetime.datetime.now().isoformat(),
            "sentimiento": sentimiento,
            "aprobada": True,  # Por defecto aprobada, podría haber moderación
            "votos_utiles": 0
        }
        
        # Almacenar según modo
        if self.modo == "firebase":
            return self._guardar_resena_firebase(resena)
        else:
            return self._guardar_resena_local(resena)
    
    def _validar_resena(self, usuario_id: str, empresa_id: str, 
                       texto: str, rating: float) -> Tuple[bool, str]:
        """
        Valida una reseña antes de guardarla.
        
        Args:
            usuario_id, empresa_id, texto, rating: Datos a validar
            
        Returns:
            tuple: (es_valida, mensaje)
        """
        # Validar longitud del texto
        if len(texto.split()) < 20:
            return False, "La reseña debe tener al menos 20 palabras"
        
        # Validar rating
        if not (1 <= rating <= 5):
            return False, "El rating debe estar entre 1 y 5"
        
        # Comprobar si el usuario ya ha comentado recientemente sobre esta empresa
        ultima_fecha = self._obtener_ultima_resena_usuario(usuario_id, empresa_id)
        
        if ultima_fecha:
            fecha_ultima = datetime.datetime.fromisoformat(ultima_fecha)
            fecha_actual = datetime.datetime.now()
            dias_transcurridos = (fecha_actual - fecha_ultima).days
            
            if dias_transcurridos < 30:
                return False, f"Ya has dejado una reseña para esta empresa en los últimos 30 días (hace {dias_transcurridos} días)"
        
        # Verificar si es un texto genérico o sospechoso de spam
        if self._es_texto_generico(texto):
            return False, "El texto parece genérico. Por favor proporciona una reseña más específica sobre tu experiencia"
        
        return True, "Reseña válida"
    
    def _obtener_ultima_resena_usuario(self, usuario_id: str, empresa_id: str) -> Optional[str]:
        """
        Obtiene la fecha de la última reseña del usuario para una empresa.
        
        Args:
            usuario_id, empresa_id: IDs para la búsqueda
            
        Returns:
            str: Fecha de la última reseña o None si no existe
        """
        if self.modo == "firebase":
            try:
                # Consultar Firestore
                query = self.db.collection('resenas') \
                          .where('usuario_id', '==', usuario_id) \
                          .where('empresa_id', '==', empresa_id) \
                          .order_by('fecha', direction=firestore.Query.DESCENDING) \
                          .limit(1)
                
                resultados = list(query.stream())
                
                if resultados:
                    return resultados[0].to_dict().get('fecha')
                
                return None
                
            except Exception as e:
                print(f"Error al buscar reseña anterior: {e}")
                return None
        else:
            try:
                # Buscar en almacenamiento local
                with open('data/resenas.json', 'r', encoding='utf-8') as f:
                    resenas = json.load(f)
                
                # Filtrar por usuario y empresa, ordenar por fecha
                resenas_usuario = [r for r in resenas 
                                  if r['usuario_id'] == usuario_id and r['empresa_id'] == empresa_id]
                
                if resenas_usuario:
                    # Ordenar por fecha (más reciente primero)
                    resenas_usuario.sort(key=lambda x: x['fecha'], reverse=True)
                    return resenas_usuario[0]['fecha']
                
                return None
                
            except Exception as e:
                print(f"Error al buscar reseña anterior: {e}")
                return None
    
    def _es_texto_generico(self, texto: str) -> bool:
        """
        Verifica si un texto parece genérico o poco informativo.
        
        Args:
            texto (str): Texto a analizar
            
        Returns:
            bool: True si el texto parece genérico
        """
        # Limpiar texto
        texto = texto.lower()
        texto = ''.join([c for c in texto if c not in string.punctuation])
        palabras = texto.split()
        
        # Eliminar stopwords
        palabras_significativas = [w for w in palabras if w not in self.stopwords_es]
        
        # Verificar cantidad de palabras significativas
        if len(palabras_significativas) < 8:
            return True
        
        # Patrones que indican texto genérico
        patrones_genericos = [
            r"(bueno|malo|regular|excelente|pésimo)\s*(servicio|atención|empresa)",
            r"(recomiendo|no recomiendo)",
            r"(buena|mala)\s*experiencia",
            r"(volveré|no volveré)"
        ]
        
        # Contar coincidencias con patrones genéricos
        coincidencias = sum(1 for patron in patrones_genericos if re.search(patron, texto))
        
        # Si hay muchas coincidencias con patrones genéricos y pocas palabras únicas
        palabras_unicas = len(set(palabras_significativas))
        porcentaje_unicas = palabras_unicas / len(palabras_significativas) if palabras_significativas else 0
        
        return (coincidencias >= 2 and porcentaje_unicas < 0.7) or porcentaje_unicas < 0.5
    
    def _analizar_sentimiento(self, texto: str) -> Dict:
        """
        Analiza el sentimiento del texto de una reseña.
        
        Args:
            texto (str): Texto a analizar
            
        Returns:
            dict: Resultado del análisis con sentimiento y puntaje
        """
        if self.sentiment_analyzer:
            try:
                # Usar transformer si está disponible
                result = self.sentiment_analyzer(texto)
                label = result[0]["label"]
                score = result[0]["score"]
                
                if label == "POS":
                    return {"tipo": "positivo", "valor": score}
                elif label == "NEG":
                    return {"tipo": "negativo", "valor": score}
                else:
                    return {"tipo": "neutro", "valor": 0.5}
            except Exception as e:
                print(f"Error en análisis de sentimiento: {e}")
        
        # Método fallback: análisis simple basado en palabras clave
        palabras_positivas = [
            "excelente", "bueno", "genial", "recomendable", "satisfecho", "feliz", 
            "encantado", "perfecto", "increíble", "maravilloso", "profesional", 
            "calidad", "mejor", "positivo", "eficiente", "rápido", "solución", 
            "amable", "atento", "fantástico", "impresionante"
        ]
        
        palabras_negativas = [
            "malo", "pésimo", "terrible", "horrible", "decepcionante", "problema",
            "queja", "reclamo", "defectuoso", "lento", "costoso", "caro", "fraude",
            "estafa", "incumplimiento", "demanda", "multa", "falla", "error", 
            "desagradable", "peligroso", "inútil", "ineficiente", "molesto"
        ]
        
        texto_lower = texto.lower()
        
        # Contar palabras positivas y negativas
        count_pos = sum(1 for palabra in palabras_positivas if palabra in texto_lower)
        count_neg = sum(1 for palabra in palabras_negativas if palabra in texto_lower)
        
        # Calcular sentimiento
        if count_pos > count_neg:
            valor = min(0.9, 0.5 + (count_pos - count_neg) * 0.1)
            return {"tipo": "positivo", "valor": valor}
        elif count_neg > count_pos:
            valor = min(0.9, 0.5 + (count_neg - count_pos) * 0.1)
            return {"tipo": "negativo", "valor": valor}
        else:
            # Analizar en base al rating implícito en el texto
            patron_rating = r'([1-5])\s*(?:estrellas?|puntos?)'
            match = re.search(patron_rating, texto_lower)
            
            if match:
                rating = int(match.group(1))
                if rating >= 4:
                    return {"tipo": "positivo", "valor": 0.7}
                elif rating <= 2:
                    return {"tipo": "negativo", "valor": 0.7}
            
            return {"tipo": "neutro", "valor": 0.5}
    
    def _guardar_resena_firebase(self, resena: Dict) -> Tuple[bool, str, Dict]:
        """
        Guarda una reseña en Firestore.
        
        Args:
            resena (dict): Datos de la reseña a guardar
            
        Returns:
            tuple: (éxito, mensaje, datos_resena)
        """
        try:
            # Guardar en colección de reseñas
            self.db.collection('resenas').document(resena['id']).set(resena)
            
            # Actualizar datos de la empresa
            self._actualizar_datos_empresa_firebase(resena)
            
            # Actualizar datos del usuario (historial de comentarios)
            comentario_usuario = {
                "empresa_id": resena['empresa_id'],
                "resena_id": resena['id'],
                "fecha": resena['fecha'],
                "rating": resena['rating'],
                "texto": resena['texto'][:100] + "..." if len(resena['texto']) > 100 else resena['texto']
            }
            
            usuario_ref = self.db.collection('usuarios').document(resena['usuario_id'])
            usuario_doc = usuario_ref.get()
            
            if usuario_doc.exists:
                usuario_data = usuario_doc.to_dict()
                comentarios = usuario_data.get('comentarios', [])
                comentarios.append(comentario_usuario)
                
                # Actualizar puntos del usuario
                puntos = usuario_data.get('puntos', 0) + 5
                
                usuario_ref.update({
                    'comentarios': comentarios,
                    'puntos': puntos
                })
            
            return True, "Reseña guardada con éxito", resena
            
        except Exception as e:
            return False, f"Error al guardar reseña: {str(e)}", None
    
    def _actualizar_datos_empresa_firebase(self, resena: Dict) -> None:
        """
        Actualiza los datos de reputación de una empresa en Firestore después de una nueva reseña.
        
        Args:
            resena (dict): Datos de la nueva reseña
        """
        try:
            # Referencia a la empresa
            empresa_ref = self.db.collection('empresas').document(resena['empresa_id'])
            empresa_doc = empresa_ref.get()
            
            if not empresa_doc.exists:
                print(f"Empresa {resena['empresa_id']} no encontrada en la base de datos")
                return
            
            empresa_data = empresa_doc.to_dict()
            
            # Actualizar rating promedio
            num_resenas = empresa_data.get('num_resenas_colaborativas', 0) + 1
            rating_actual = empresa_data.get('rating_colaborativo', 0)
            
            nuevo_rating = ((rating_actual * (num_resenas - 1)) + resena['rating']) / num_resenas
            
            # Actualizar contadores de sentimiento
            sentimiento = resena['sentimiento']['tipo']
            sentimiento_contadores = empresa_data.get('sentimiento_colaborativo', {
                'positivo': 0,
                'neutro': 0,
                'negativo': 0
            })
            
            sentimiento_contadores[sentimiento] = sentimiento_contadores.get(sentimiento, 0) + 1
            
            # Actualizar empresa
            actualizacion = {
                'num_resenas_colaborativas': num_resenas,
                'rating_colaborativo': nuevo_rating,
                'sentimiento_colaborativo': sentimiento_contadores,
                'ultima_actualizacion': datetime.datetime.now()
            }
            
            # Si es la primera reseña, inicializar listas
            if num_resenas == 1:
                actualizacion['resenas_recientes'] = [resena['id']]
            else:
                # Añadir a lista de reseñas recientes (máximo 10)
                resenas_recientes = empresa_data.get('resenas_recientes', [])
                resenas_recientes.append(resena['id'])
                if len(resenas_recientes) > 10:
                    resenas_recientes = resenas_recientes[-10:]
                actualizacion['resenas_recientes'] = resenas_recientes
            
            # Aplicar actualización
            empresa_ref.update(actualizacion)
            
        except Exception as e:
            print(f"Error al actualizar datos de empresa: {e}")
    
    def _guardar_resena_local(self, resena: Dict) -> Tuple[bool, str, Dict]:
        """
        Guarda una reseña en el almacenamiento local.
        
        Args:
            resena (dict): Datos de la reseña a guardar
            
        Returns:
            tuple: (éxito, mensaje, datos_resena)
        """
        try:
            # Cargar reseñas existentes
            with open('data/resenas.json', 'r', encoding='utf-8') as f:
                resenas = json.load(f)
            
            # Añadir nueva reseña
            resenas.append(resena)
            
            # Guardar reseñas actualizadas
            with open('data/resenas.json', 'w', encoding='utf-8') as f:
                json.dump(resenas, f, indent=4)
            
            # Actualizar datos de la empresa
            self._actualizar_datos_empresa_local(resena)
            
            # Actualizar historial del usuario
            self._actualizar_historial_usuario_local(resena)
            
            return True, "Reseña guardada con éxito", resena
            
        except Exception as e:
            return False, f"Error al guardar reseña: {str(e)}", None
    
    def _actualizar_datos_empresa_local(self, resena: Dict) -> None:
        """
        Actualiza los datos de reputación de una empresa en el almacenamiento local.
        
        Args:
            resena (dict): Datos de la nueva reseña
        """
        try:
            # Cargar empresas
            with open('data/empresas.json', 'r', encoding='utf-8') as f:
                empresas = json.load(f)
            
            # Buscar la empresa
            empresa_encontrada = False
            for i, empresa in enumerate(empresas):
                if empresa['id'] == resena['empresa_id']:
                    # Actualizar rating promedio
                    num_resenas = empresa.get('num_resenas_colaborativas', 0) + 1
                    rating_actual = empresa.get('rating_colaborativo', 0)
                    
                    nuevo_rating = ((rating_actual * (num_resenas - 1)) + resena['rating']) / num_resenas
                    
                    # Actualizar contadores de sentimiento
                    sentimiento = resena['sentimiento']['tipo']
                    sentimiento_contadores = empresa.get('sentimiento_colaborativo', {
                        'positivo': 0,
                        'neutro': 0,
                        'negativo': 0
                    })
                    
                    sentimiento_contadores[sentimiento] = sentimiento_contadores.get(sentimiento, 0) + 1
                    
                    # Actualizar empresa
                    empresas[i]['num_resenas_colaborativas'] = num_resenas
                    empresas[i]['rating_colaborativo'] = nuevo_rating
                    empresas[i]['sentimiento_colaborativo'] = sentimiento_contadores
                    empresas[i]['ultima_actualizacion'] = datetime.datetime.now().isoformat()
                    
                    # Manejar lista de reseñas recientes
                    if 'resenas_recientes' not in empresas[i]:
                        empresas[i]['resenas_recientes'] = []
                    
                    empresas[i]['resenas_recientes'].append(resena['id'])
                    if len(empresas[i]['resenas_recientes']) > 10:
                        empresas[i]['resenas_recientes'] = empresas[i]['resenas_recientes'][-10:]
                    
                    empresa_encontrada = True
                    break
            
            # Si no se encontró la empresa, podría ser un error
            if not empresa_encontrada:
                print(f"Empresa {resena['empresa_id']} no encontrada en la base de datos")
            
            # Guardar empresas actualizadas
            with open('data/empresas.json', 'w', encoding='utf-8') as f:
                json.dump(empresas, f, indent=4)
                
        except Exception as e:
            print(f"Error al actualizar datos de empresa: {e}")
    
    def _actualizar_historial_usuario_local(self, resena: Dict) -> None:
        """
        Actualiza el historial de comentarios de un usuario en el almacenamiento local.
        
        Args:
            resena (dict): Datos de la reseña para agregar al historial
        """
        try:
            # Cargar usuarios
            with open('data/usuarios.json', 'r', encoding='utf-8') as f:
                usuarios = json.load(f)
            
            # Crear resumen de comentario para el historial
            comentario_usuario = {
                "empresa_id": resena['empresa_id'],
                "resena_id": resena['id'],
                "fecha": resena['fecha'],
                "rating": resena['rating'],
                "texto": resena['texto'][:100] + "..." if len(resena['texto']) > 100 else resena['texto']
            }
            
            # Buscar y actualizar usuario
            usuario_encontrado = False
            for i, usuario in enumerate(usuarios):
                if usuario['uid'] == resena['usuario_id']:
                    # Añadir comentario al historial
                    if 'comentarios' not in usuarios[i]:
                        usuarios[i]['comentarios'] = []
                    
                    usuarios[i]['comentarios'].append(comentario_usuario)
                    
                    # Actualizar puntos
                    if 'puntos' not in usuarios[i]:
                        usuarios[i]['puntos'] = 0
                    
                    usuarios[i]['puntos'] += 5
                    
                    # Actualizar nivel si corresponde
                    puntos_totales = usuarios[i]['puntos']
                    if puntos_totales >= 1000 and usuarios[i].get('nivel', 1) < 4:
                        usuarios[i]['nivel'] = 4
                    elif puntos_totales >= 300 and usuarios[i].get('nivel', 1) < 3:
                        usuarios[i]['nivel'] = 3
                    elif puntos_totales >= 100 and usuarios[i].get('nivel', 1) < 2:
                        usuarios[i]['nivel'] = 2
                    
                    usuario_encontrado = True
                    break
            
            if not usuario_encontrado:
                print(f"Usuario {resena['usuario_id']} no encontrado en la base de datos")
            
            # Guardar usuarios actualizados
            with open('data/usuarios.json', 'w', encoding='utf-8') as f:
                json.dump(usuarios, f, indent=4)
                
        except Exception as e:
            print(f"Error al actualizar historial de usuario: {e}")
    
    def obtener_resenas_empresa(self, empresa_id: str, limite: int = 10, 
                             solo_aprobadas: bool = True) -> List[Dict]:
        """
        Obtiene las reseñas de una empresa específica.
        
        Args:
            empresa_id (str): ID de la empresa
            limite (int): Número máximo de reseñas a obtener
            solo_aprobadas (bool): Si solo se deben incluir reseñas aprobadas
            
        Returns:
            list: Lista de reseñas
        """
        if self.modo == "firebase":
            try:
                # Consultar Firestore
                query = self.db.collection('resenas').where('empresa_id', '==', empresa_id)
                
                if solo_aprobadas:
                    query = query.where('aprobada', '==', True)
                
                query = query.order_by('fecha', direction=firestore.Query.DESCENDING).limit(limite)
                
                resenas = []
                for doc in query.stream():
                    resenas.append(doc.to_dict())
                
                return resenas
                
            except Exception as e:
                print(f"Error al obtener reseñas: {e}")
                return []
        else:
            try:
                # Cargar reseñas
                with open('data/resenas.json', 'r', encoding='utf-8') as f:
                    todas_resenas = json.load(f)
                
                # Filtrar por empresa y estado de aprobación
                resenas_empresa = [r for r in todas_resenas if r['empresa_id'] == empresa_id]
                
                if solo_aprobadas:
                    resenas_empresa = [r for r in resenas_empresa if r.get('aprobada', True)]
                
                # Ordenar por fecha (más recientes primero)
                resenas_empresa.sort(key=lambda x: x['fecha'], reverse=True)
                
                # Limitar cantidad
                return resenas_empresa[:limite]
                
            except Exception as e:
                print(f"Error al obtener reseñas: {e}")
                return []
    
